# Local backend OAuth issuer and Platform API. Use HTTPS public URLs in staging/production.
MCP_BACKEND_API_URL=http://127.0.0.1:8001
# MCP_OAUTH_ISSUER defaults to MCP_BACKEND_API_URL; override only if the issuer differs.
MCP_RESOURCE_URL=http://127.0.0.1:8002/mcp/
# Same dedicated 32+ character key as backend MCP_BRIDGE_SECRET; never use JWT_SECRET_KEY.
# Generate once with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_BRIDGE_SECRET=

# Standalone MCP service settings.
MCP_HOST=127.0.0.1
MCP_PORT=8002
MCP_API_TIMEOUT_SECONDS=45
MCP_API_CONNECT_TIMEOUT_SECONDS=10

# Transport Host/Origin checks derive the MCP origin from MCP_RESOURCE_URL.
# Keep the dashboard enabled only for private local testing.
MCP_DASHBOARD_ENABLED=true
# Per-process guard. Use a shared gateway limiter for multi-worker deployment.
MCP_RATE_LIMIT_REQUESTS=120
MCP_RATE_LIMIT_WINDOW_SECONDS=60

# Behind a reverse proxy/ingress, uvicorn only trusts X-Forwarded-For from these IPs
# (default 127.0.0.1). Set to the proxy address so rate limiting sees real client IPs.
# FORWARDED_ALLOW_IPS=
