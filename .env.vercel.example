# Set these in the Vercel dashboard; this file contains placeholders, not secrets.
# Use the stable domain of your dedicated MCP test project, including /mcp/.
MCP_RESOURCE_URL=https://shortsmaker-mcp-test.vercel.app/mcp/
MCP_PUBLIC_URL=https://shortsmaker-mcp-test.vercel.app

# HTTPS ngrok origin forwarding to the local backend connected to local test Postgres.
MCP_BACKEND_API_URL=https://your-backend.ngrok-free.app
MCP_OAUTH_ISSUER=https://your-backend.ngrok-free.app

# Same dedicated random 32+ character secret as the local backend.
MCP_BRIDGE_SECRET=
MCP_DASHBOARD_ENABLED=false
MCP_API_TIMEOUT_SECONDS=45
MCP_API_CONNECT_TIMEOUT_SECONDS=10
MCP_CREDITS_PER_USD=100
